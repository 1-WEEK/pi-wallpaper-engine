{
  "name": "pi-wallpaper-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Wallpaper Engine video wallpaper player for Raspberry Pi 4B",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash dev.sh",
    "dev:backend": "bun run --filter @pwe/backend dev",
    "dev:frontend": "bun run --filter @pwe/frontend dev",
    "build": "bun run --filter @pwe/frontend build",
    "check": "bun run --filter @pwe/backend check",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "bun run --filter '*' typecheck",
    "service:start": "systemctl --user start pi-wallpaper-engine",
    "service:stop": "systemctl --user stop pi-wallpaper-engine",
    "service:restart": "bun scripts/restart-prod.ts",
    "service:status": "systemctl --user status pi-wallpaper-engine",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "[ -d node_modules ] && bun test; [ -d .codegraph ] && codegraph index || true",
    "post-merge": "[ -d .codegraph ] || codegraph init; codegraph index || true",
    "post-checkout": "[ -d .codegraph ] || codegraph init; codegraph index || true"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.6.2",
    "@types/bun": "^1.4.3",
    "playwright": "^1.64.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
